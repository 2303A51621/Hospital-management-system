NODE_ENV=production
PORT=

# Use one production MongoDB URI. Do not commit the real value.
MONGODB_URI=<mongodb-atlas-connection-string>
# Compatibility aliases used by local scripts/tests:
MONGO_URI=
MONGODB_ATLAS_URI=
LOCAL_MONGODB_URI=mongodb://localhost:27017/kushal_hospitals
FALLBACK_LOCAL_MONGODB=false

# Generate and enter a long random value in Render.
JWT_SECRET=<generate-in-render>
JWT_EXPIRES_IN=7d
CLIENT_URL=https://<frontend-service>.onrender.com
FRONTEND_URL=
FRONTEND_URLS=

# Optional Razorpay settings. Leave unset when payments are disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional SMTP settings for appointment reminders.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_PASS=

# Optional Twilio settings for appointment reminders.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional application defaults and one-time seed configuration.
EMERGENCY_PHONE=<emergency-phone-number>
SEED_DOCTOR_PASSWORD=<set-only-when-running-doctor-seed>
